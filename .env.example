POSTGRES_DB=zoho_tally
POSTGRES_USER=zoho_tally
POSTGRES_PASSWORD=zoho_tally
DATABASE_URL=postgresql+psycopg://zoho_tally:zoho_tally@postgres:5432/zoho_tally
CLOUD_API_KEY=dev-cloud-api-key
# Secrets-at-rest key (Zoho tokens, connector secrets). Generate a strong value
# for production, e.g. python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
ZOHO_RATE_LIMIT_PER_MIN=90
AGENT_NAME=local-agent-1
AGENT_POLL_SIZE=10
AGENT_LOCAL_STORE=/data/agent.json
CLOUD_BASE_URL=http://cloud-app:8000
